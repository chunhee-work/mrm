# 名字只列在这里。值写在机器上的 /etc/autopilot-worker.env，不要提交。
# Neon 直连串（主机名不要带 -pooler），角色只需本仓库这些表的读写。
DATABASE_URL=
# 私有 Vercel Blob。只读案件文件。
BLOB_READ_WRITE_TOKEN=
# 只读 Hugging Face 仓库 chunhee00/mrm-photo-model 的 production/。
HF_TOKEN=
HF_MODEL_REPO=
# 网站读文件仍用 Claude。Worker 自己不调用时留空。
ANTHROPIC_API_KEY=
# 与网站相同：不是 on 则 worker 不碰 Merimen。
EXT_CONNECT=
# 32 字节密钥的 base64。网站加密，worker 只在登录时解密。
MERIMEN_CRED_KEY=
# on 才会真的向 Merimen 提交一次登录。核对失败不会重试（对方 locktime=15）。
MERIMEN_LOGIN=
# on：用 DINOv2 写 case_photos，网站不再把这些照片送给 Claude。
PHOTO_WORKER=
# 模型失败时是否仍让网站用 Claude。默认开；写成 off 才关掉。
PHOTO_WORKER_FALLBACK=
# on：/connection 和案子页显示这台 worker，不打开 Browserbase。
WORKER_UI=
# 默认不要设。MERIMEN_DRYRUN=on：只填表检查建案表单，什么都不保存，并且优先于下面两个开关。
# 两个都是 on 且 MERIMEN_DRYRUN 没开，才会在 Phase A 第 1 步真的点 Next 建案子；其它步骤仍未移植，仍会停住。
MERIMEN_DRYRUN=
MERIMEN_WRITES=
WORKER_SUBMIT=
WORKER_ID=
WORKER_STATE=
# 账号键:端口。一个 Chrome 配置目录对应一个 Merimen 登录。
WORKER_ACCOUNTS=
# 机构 id:账号键。多账号时必须写，禁止猜。
WORKER_ORG_ACCOUNTS=
CHROME_BIN=
PRED_BS=
POLL_SECONDS=
ORG_CONCURRENCY=
WORKER_HEALTH_PORT=
RESEND_API_KEY=
EMAIL_FROM=
# http（默认）= Neon SQL-over-HTTPS，不需要出站 5432；tcp = 普通 psycopg 连接。
DB_TRANSPORT=
# job 租约秒数（默认 900）。运行中的 job 每三分之一租约续一次。
JOB_LEASE_SECONDS=
# 进度截图保留天数（默认 90）。截图只在 WORKER_UI=on 且有 BLOB_READ_WRITE_TOKEN 时才截。
SCREENSHOT_RETENTION_DAYS=
