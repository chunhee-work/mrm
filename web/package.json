{
  "name": "autoclaim-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-schema.ts && next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test \"src/**/*.test.ts\" && node --import tsx --test tests/*.test.ts && node --conditions=react-server --import tsx --test \"test/*.test.ts\" && tsx scripts/test-scan-case.ts",
    "e2e": "node e2e/desk.e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "better-auth": "^1.7.23",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "three": "0.170.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
