# Names only. Real values are set by the owner in Vercel / worker env. Never commit .env files.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
RESEND_API_KEY=
EMAIL_FROM=Autopilotclaim <noreply@autopilotclaim.com>
BLOB_READ_WRITE_TOKEN=
ANTHROPIC_API_KEY_APP=
# optional: CLAUDE_MODEL=claude-opus-5-5
TYPESAFE_API_KEY=
# optional: CLAUDE_MODEL_PHOTOS, PHOTO_COST_CAP_USD
# Payments (plan chunhee-work/mrm#12). Names only.
# test (default) | live. Live refuses packs that are not owner-approved in src/lib/payments/packs.ts
PAYMENTS_MODE=
# Lemon Squeezy (cards / PayPal, USD). One variant id per pack: LEMONSQUEEZY_VARIANT_PACK_1 / _PACK_5 / _PACK_10
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PACK_1=
LEMONSQUEEZY_VARIANT_PACK_5=
LEMONSQUEEZY_VARIANT_PACK_10=
# toyyibPay (FPX online banking, MYR). Optional TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com for sandbox
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_BASE_URL=
# Local development only (ignored in production): fake provider, no money
PAYMENTS_MOCK=
# Optional: what one TypeSafe (Jev) call costs, USD. Without it Jev calls are counted but shown as "without a price".
TYPESAFE_COST_PER_CALL_USD=
